# Copy to local.env and fill in. Never commit local.env.
# Skills that need machine/project paths: read local.env (see local.env.example).

# scripts/keepalive.py: PostgREST URL of public.alive and a publishable key
KEEPALIVE_URL=https://<project_ref>.supabase.co/rest/v1/alive
KEEPALIVE_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TELEMETRY_IGNORE_IPS=

# scripts/resume_view.py, scripts/resume_select/*: read-only DB role (resume_reader) connection URL
RESUME_READER_DB_URL=postgresql://resume_reader:<password>@<host>:5432/postgres
# scripts/resume_select/*: Gemini API key for the default flash runner (--runner gemini).
# Fallback: --runner claude uses the Claude CLI (`claude` on PATH, already logged in).
RESUME_GEMINI_KEY=
